# Copia questo file in `.env` e inserisci i valori reali.
# Attenzione: tutte le variabili con prefisso VITE_ finiscono nel bundle
# pubblico. Non inserire qui chiavi segrete (service_role, R2 secret key):
# vanno usate solo lato server / edge function.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cloudflare R2 — solo l'URL pubblico serve al browser
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
VITE_R2_BUCKET=loasi
